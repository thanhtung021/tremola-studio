# Empty template only. Never commit filled private credentials.
# Public browser endpoint for the separately configured backend.
VITE_SUPABASE_URL=
# Public browser key; RLS must enforce access.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Managed public project identifier (no direct app read today).
VITE_SUPABASE_PROJECT_ID=
# Server backend endpoint and SSR fallback.
SUPABASE_URL=
# Publishable server key for RLS-scoped lead submissions/auth.
SUPABASE_PUBLISHABLE_KEY=
# Managed server project identifier (no direct app read today).
SUPABASE_PROJECT_ID=
# Server-only privileged admin key; helper exists, not used by lead forms.
# Provision at destination; managed Lovable Cloud does not expose this key to owners.
SUPABASE_SERVICE_ROLE_KEY=
# Optional Google Analytics identifier; empty disables GA.
VITE_GA4_ID=
# Optional Meta Pixel identifier; empty disables Meta.
VITE_META_PIXEL_ID=
# Real hosted free-pack download URL; absent uses labelled placeholder.
VITE_FREE_PACK_URL=
# Tooling-only privileged PostgreSQL migration connection; never client-side.
LOVABLE_DB_MIGRATION_URL=
# Server-only managed cron credential; generated helper currently unused.
LOVABLE_CRON_SECRET=
# Optional prior cron credential during rotation; currently unused.
LOVABLE_CRON_SECRET_PREVIOUS=
# Hosted platform secret; no current app AI/connector calls or source read.
LOVABLE_API_KEY=
# Hosted legacy/platform binding; no direct app source read today.
SUPABASE_ANON_KEY=
# Hosted platform database binding; no direct app source read today.
SUPABASE_DB_URL=
