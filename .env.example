# Empty template only. Copy to .env.local (git-ignored) and fill in. Never commit real values.
# VITE_* values are PUBLIC: they are baked into the browser bundle. Everything else is server-only
# and is set as a Cloudflare Worker secret/var in deployed environments (see docs/DEPLOY.md).

# ── Site ──────────────────────────────────────────────────────────────
# Canonical origin used for canonical/hreflang/OG/sitemap. No trailing slash.
SITE_URL=https://tremolastudio.com
VITE_SITE_URL=https://tremolastudio.com
# "production" | "preview" | "development". Non-production environments are noindex.
VITE_APP_ENV=development

# ── Supabase (own project, see docs/BACKEND.md) ───────────────────────
VITE_SUPABASE_URL=
# Publishable key (sb_publishable_...). Used by the browser only for admin sign-in.
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) or legacy service_role JWT. Server-only, bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# ── Email (Resend, see docs/BACKEND.md#email) ─────────────────────────
RESEND_API_KEY=
# Sender, e.g. "Tremola Studio <hello@mail.tremolastudio.com>". Must be on a verified Resend domain.
EMAIL_FROM=
# Internal inbox that receives new audit requests and pack sign-ups (comma-separated allowed).
SALES_INBOX=
# Reply-To for visitor confirmation emails.
EMAIL_REPLY_TO=
# "true" to send the visitor confirmation emails (needs a verified sending domain).
SEND_VISITOR_CONFIRMATION=false

# ── Free pack (Cloudflare R2, private bucket) ─────────────────────────
# Object key of the pack ZIP in the private R2 bucket bound as PACKS (wrangler.jsonc).
FREE_PACK_OBJECT_KEY=free-pack/tremola-free-pack-v1.zip
# HMAC secret for signed download links (any long random string).
DOWNLOAD_SIGNING_SECRET=
# Link lifetime in seconds.
DOWNLOAD_TTL_SECONDS=86400

# ── Media (public R2 bucket behind a CDN domain) ──────────────────────
# Base URL for processed audio/video/images, e.g. https://media.tremolastudio.com. Empty = /media on this site.
VITE_MEDIA_BASE_URL=

# ── Analytics (optional, consent-gated) ───────────────────────────────
VITE_GA4_ID=
VITE_META_PIXEL_ID=

# ── Error tracking (optional, Sentry free tier) ───────────────────────
VITE_SENTRY_DSN=
SENTRY_DSN=
